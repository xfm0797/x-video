{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Video",
  "version": "0.1.0",
  "identifier": "com.xfm.xvideo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "X-Video 播放器",
    "windows": [
      {
        "title": "X-Video 播放器",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
